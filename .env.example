AMITYSPACE_PORT=3001
AMITYSPACE_INTERNAL_PORT=8080
# Defaulted for low-memory hosts such as t3.small. Override only if you know the box can handle more.
AMITYSPACE_JAVA_OPTS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:ActiveProcessorCount=1 -XX:+ExitOnOutOfMemoryError -Djava.awt.headless=true
# Optional. Leave blank to use the fallback already defined in application.properties.
OPENWEATHER_API_KEY=
